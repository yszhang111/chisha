:host { display: block; }
.roulette { position: relative; margin: 0 auto; overflow: hidden; }
.wheel-image { display: block; width: 100%; height: 100%; transform-origin: 50% 50%; will-change: transform; }
.wheel-hub { position: absolute; top: 41.071429%; left: 41.071429%; width: 17.857143%; height: 17.857143%; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; }
.wheel-hub>view { width: 80%; height: 80%; border-radius: 50%; background: #fffdf4; display: flex; align-items: center; justify-content: center; }
.wheel-pointer { position: absolute; top: 1.785714%; left: 45.714286%; width: 0; height: 0; border-left-style: solid; border-right-style: solid; border-top-style: solid; border-left-color: transparent; border-right-color: transparent; }
.bitmap-canvas { position: fixed; left: -10000px; top: -10000px; width: 280px; height: 280px; pointer-events: none; }
.canvas-error { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #879278; background: #edf0e4; font-size: 23rpx; border-radius: 50%; }
.canvas-error button { font-size: 24rpx; background: #284b38; color: #fffdf4; border-radius: 15rpx; margin-top: 15rpx; padding: 12rpx 20rpx; line-height: 1.4; }
.canvas-error button::after { border: 0; }
