page { height: 100%; overflow: hidden; }
.screen { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.content-scroll { flex: 1; height: 0; min-height: 0; overflow: hidden; }
.page { padding: 0 32rpx 40rpx; }
.brand-row { display: flex; align-items: center; justify-content: space-between; height: 104rpx; border-bottom: 1rpx solid #e5e8db; }
.brand { display: flex; align-items: center; }
.brand-mark { width: 54rpx; height: 54rpx; border-radius: 17rpx; background: #284b38; color: #f3c956; font-weight: 700; font-size: 30rpx; display: flex; align-items: center; justify-content: center; transform: rotate(-6deg); }
.brand-name { font-size: 39rpx; font-weight: 800; margin-left: 14rpx; letter-spacing: -2rpx; }
.brand-dot { color: #b6a553; }
.brand-caption { font-size: 20rpx; color: #929b85; margin-left: 22rpx; padding-left: 18rpx; border-left: 1rpx solid #daddce; }
.help-link { color: #87947b; font-size: 23rpx; padding: 15rpx 0 15rpx 15rpx; }
.hero { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 46rpx 0 44rpx; }
.hero-copy { position: relative; z-index: 1; }
.eyebrow { font-size: 20rpx; color: #7e8b6d; letter-spacing: 2rpx; display: block; margin-bottom: 19rpx; }
.hero-title { font-size: 59rpx; font-weight: 800; line-height: 1.45; letter-spacing: -2rpx; }
.underline { position: relative; z-index: 0; }
.underline::after { content: ''; position: absolute; height: 13rpx; border-radius: 50%; bottom: 0; left: -2rpx; right: -4rpx; background: #f3c956; z-index: -1; transform: rotate(-4deg); }
.hero-subtitle { display: block; font-size: 22rpx; color: #929b85; line-height: 1.8; margin-top: 18rpx; }
.hero-avatar { position: absolute; width: 178rpx; height: 178rpx; right: 0; top: 70rpx; border-radius: 50%; }
.card { background: #fffefa; border: 1rpx solid #e4e7d9; border-radius: 34rpx; overflow: hidden; }
.card-heading { padding: 33rpx 32rpx 29rpx; border-bottom: 1rpx solid #e9eadf; display: flex; align-items: center; justify-content: space-between; }
.card-title { display: block; font-size: 31rpx; font-weight: 650; }
.card-subtitle { display: block; color: #97a087; font-size: 21rpx; margin-top: 9rpx; }
.text-button { font-size: 23rpx; color: #9ba28e; padding: 12rpx 0 12rpx 18rpx; }
.field { padding: 31rpx 32rpx; border-bottom: 1rpx solid #eaebdf; }
.field-title { display: flex; align-items: center; font-size: 28rpx; font-weight: 600; }
.step { color: #a1aa93; font-size: 20rpx; font-weight: 400; margin-right: 17rpx; letter-spacing: 1rpx; }
.tag { color: #a1a58f; background: #f1f3e9; font-size: 18rpx; font-weight: 400; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 14rpx; }
.tag.required { color: #a38b45; background: #f7edd3; }
.field-count { color: #9fa78f; font-size: 20rpx; margin-left: auto; font-weight: 400; }
.field-hint { display: block; font-size: 22rpx; color: #979f8b; line-height: 1.7; margin: 15rpx 0 21rpx; }
.input-row { display: flex; align-items: stretch; width: 100%; }
.restaurant-input { height: 83rpx; min-width: 0; flex: 1; background: #fffefa; border: 1rpx solid #dce1cf; border-radius: 15rpx; padding: 0 22rpx; font-size: 25rpx; }
.restaurant-input.invalid { border-color: #cf8c73; }
.input-placeholder { color: #b0b6a2; }
.add-button { margin-left: 13rpx; width: 83rpx; height: 83rpx; flex: 0 0 83rpx; background: #284b38; color: #fffefa; font-size: 44rpx; border-radius: 15rpx; display: flex; align-items: center; justify-content: center; line-height: 1; padding-bottom: 3rpx; }
.add-button[disabled] { background: #a3b096; color: #fffefa; }
.error { display: block; font-size: 22rpx; color: #b76449; margin-top: 14rpx; line-height: 1.5; }
.restaurant-chips { display: flex; flex-wrap: wrap; margin-top: 15rpx; }
.restaurant-chip { max-width: 100%; display: flex; align-items: center; padding: 10rpx 13rpx 10rpx 18rpx; background: #eaf0e0; border: 1rpx solid #e0e7d5; border-radius: 11rpx; color: #5c724a; font-size: 23rpx; margin: 0 10rpx 10rpx 0; line-height: 1.4; }
.chip-name { max-width: 480rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chip-x { margin-left: 12rpx; font-size: 26rpx; color: #91a17b; }
.suggestions { display: flex; flex-wrap: nowrap; align-items: center; color: #a6ad97; font-size: 21rpx; margin-top: 17rpx; }
.suggestions-label { flex: none; white-space: nowrap; }
.suggestions button { width: auto; flex: none; white-space: nowrap; font-size: 21rpx; color: #7d8e68; margin-left: 12rpx; padding: 7rpx 0; }
.suggestions button[disabled] { color: #bbc2ae; }
.input-hint { display: block; font-size: 19rpx; color: #a9b19a; margin-top: 10rpx; }
.date-button { width: 100%; min-height: 82rpx; padding: 0 21rpx; border: 1rpx solid #dfe3d3; border-radius: 15rpx; display: flex; align-items: center; font-size: 24rpx; color: #9ca68e; text-align: left; }
.date-button.has-dates { background: #f5f8ee; border-color: #b8c8a2; color: #67804f; }
.calendar-icon { position: relative; width: 29rpx; height: 29rpx; border: 2rpx solid #91a17a; border-radius: 6rpx; margin-right: 17rpx; display: flex; align-items: center; justify-content: center; color: #91a17a; font-size: 18rpx; }
.calendar-icon>view { position: absolute; left: 0; right: 0; top: 6rpx; border-top: 2rpx solid #91a17a; }
.calendar-icon>text { padding-top: 6rpx; font-size: 14rpx; }
.chevron { font-size: 37rpx; margin-left: auto; color: #a5af94; transform: rotate(90deg); }
.date-button.is-open .chevron { transform: rotate(-90deg); }
.date-chips { display: flex; align-items: center; flex-wrap: wrap; margin-top: 16rpx; }
.date-chip { display: flex; align-items: center; background: #f6edd6; color: #a18843; border-radius: 8rpx; padding: 7rpx 11rpx; font-size: 21rpx; margin: 0 9rpx 8rpx 0; }
.date-chip>text { margin-left: 10rpx; color: #bca46e; }
.date-overflow { color: #a6a287; font-size: 20rpx; margin-bottom: 8rpx; }
.meal-field { border-bottom: 0; padding-bottom: 33rpx; }
.meal-toggle { display: flex; align-items: center; border: 1rpx solid #e0e5d3; border-radius: 17rpx; padding: 23rpx 20rpx; margin-top: 23rpx; }
.meal-toggle.checked { background: #f0f5e7; border-color: #afc396; }
.meal-symbol { position: relative; color: #c0a05c; width: 55rpx; flex: none; font-size: 39rpx; margin-right: 18rpx; }
.meal-symbol>text:last-child { position: absolute; font-size: 30rpx; color: #87966f; right: -2rpx; bottom: -3rpx; }
.meal-copy { display: flex; flex: 1; flex-direction: column; font-size: 25rpx; }
.meal-caption { color: #9aa58a; font-size: 21rpx; margin-top: 9rpx; }
.meal-checkbox { transform: scale(.8); margin: -4rpx -9rpx -4rpx 8rpx; flex: none; }
.save-note { display: flex; align-items: center; justify-content: center; font-size: 19rpx; color: #a1ac91; background: #f7f9ef; padding: 21rpx 15rpx; border-top: 1rpx solid #e8ecdd; }
.status-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #94a67b; margin-right: 11rpx; flex: none; }
.stage { position: relative; z-index: 0; margin-top: 28rpx; background: #edf0e4; border: 1rpx solid #dfe6d2; border-radius: 34rpx; padding: 31rpx 24rpx 26rpx; overflow: hidden; }
.stage-heading { display: flex; justify-content: space-between; align-items: center; padding: 0 6rpx; }
.stage-eyebrow { display: block; font-size: 14rpx; letter-spacing: 3rpx; color: #98a686; }
.stage-title { display: block; font-size: 29rpx; font-weight: 600; margin-top: 14rpx; }
.active-pill { border: 1rpx solid #d7e0c6; background: #f4f6ec; color: #8a9c74; border-radius: 30rpx; padding: 7rpx 12rpx; font-size: 17rpx; white-space: nowrap; margin-left: 10rpx; }
.empty-stage { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 35rpx 0 30rpx; }
.empty-avatar { width: 310rpx; height: 310rpx; border-radius: 50%; margin: 0 0 14rpx; }
.empty-title { font-size: 29rpx; font-weight: 600; margin-bottom: 18rpx; }
.empty-copy { color: #94a083; font-size: 23rpx; line-height: 1.9; }
.empty-copy>text { display: block; }
.empty-link { color: #65814d; padding: 24rpx 12rpx 6rpx; font-size: 23rpx; }
.wheels { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; padding: 35rpx 0 20rpx; }
.wheel-block { text-align: center; }
.wheel-large { width: 100%; }
.wheel-small { width: 50%; margin-top: 30rpx; }
.wheel-label { display: flex; justify-content: center; align-items: center; font-size: 26rpx; font-weight: 600; margin: 0 0 12rpx; }
.wheel-dot { background: #809e62; width: 9rpx; height: 9rpx; border-radius: 50%; margin-right: 10rpx; }
.wheel-date .wheel-dot { background: #c0a14c; }
.wheel-meal .wheel-dot { background: #cb9470; }
.wheel-count { font-size: 19rpx; color: #99a78b; margin-left: 12rpx; font-weight: 400; }
.wheel-small .wheel-label { font-size: 24rpx; }
.wheel-small .wheel-count { font-size: 16rpx; margin-left: 8rpx; }
.wheel-caption { display: block; font-size: 22rpx; color: #94a180; margin: 11rpx 10rpx 0; line-height: 1.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wheel-small .wheel-caption { font-size: 20rpx; }
.wheel-caption.picked { color: #4d6e3b; font-weight: 600; }
.stage-note { border-top: 1rpx dashed #d4ddc5; margin-top: 18rpx; padding-top: 23rpx; display: flex; align-items: center; justify-content: center; color: #98a68a; font-size: 20rpx; }
.stage-note>text:first-child { margin-right: 10rpx; font-size: 25rpx; }
.result-card { margin: 24rpx 3rpx 12rpx; border: 1rpx solid #d7e2c7; border-radius: 24rpx; padding: 25rpx 26rpx 20rpx; background: #fffdf3; animation: result-in .35s ease-out; }
.result-top { display: flex; align-items: center; font-size: 20rpx; color: #9aa384; letter-spacing: 1rpx; }
.result-star { width: 45rpx; height: 45rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #a38a3b; background: #f6e1a7; margin-right: 13rpx; font-size: 30rpx; }
.result-name { display: block; margin-top: 18rpx; font-size: 40rpx; font-weight: 700; word-break: break-all; line-height: 1.5; }
.result-meta { display: block; color: #879774; font-size: 24rpx; line-height: 1.7; margin-top: 7rpx; }
.result-actions { display: flex; border-top: 1rpx solid #e8ebdb; margin-top: 24rpx; padding-top: 18rpx; }
.result-actions>button { flex: 1; color: #758b5d; font-size: 23rpx; padding: 9rpx 0; }
.result-actions>button:last-child { border-left: 1rpx solid #e5e9d8; }
.footer { display: flex; align-items: center; justify-content: center; color: #abb49b; font-size: 20rpx; padding: 35rpx 0 10rpx; }
.footer-brand { font-size: 29rpx; font-weight: 800; margin-right: 17rpx; color: #8f9f7e; }
.bottom-bar { position: relative; flex: none; border-top: 1rpx solid #e0e5d4; background: #fffefa; padding: 19rpx 32rpx 20rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.bottom-inner { display: flex; align-items: center; }
.bottom-copy { flex: 1; min-width: 0; font-size: 25rpx; display: flex; flex-direction: column; padding-right: 10rpx; }
.bottom-hint { font-size: 20rpx; color: #9da98d; margin-top: 7rpx; }
.spin-button { height: 88rpx; width: 346rpx; border-radius: 19rpx; color: #fffdf3; background: #284b38; font-size: 29rpx; font-weight: 600; display: flex; justify-content: center; align-items: center; letter-spacing: 1rpx; box-shadow: 0 4rpx 0 #1e3c2b; }
.spin-button.muted { background: #97a78a; box-shadow: 0 4rpx 0 #839674; }
.spin-button[disabled] { background: #526f45; color: #eef2e4; }
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1100; background: rgba(30,48,33,.4); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fffefa; border-radius: 35rpx 35rpx 0 0; padding: 14rpx 34rpx 30rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.sheet-handle { height: 7rpx; width: 64rpx; border-radius: 8rpx; background: #dfe5d3; margin: 0 auto 30rpx; }
.sheet-title { display: flex; align-items: flex-start; justify-content: space-between; font-size: 34rpx; font-weight: 650; }
.sheet-description { display: block; color: #a0ab90; font-size: 23rpx; font-weight: 400; margin-top: 13rpx; }
.close-sheet { display: flex; justify-content: center; align-items: center; width: 58rpx; height: 58rpx; font-size: 40rpx; color: #919e80; background: #f0f3e8; border-radius: 50%; line-height: 1; margin-top: -3rpx; }
.inline-calendar { margin-top: 15rpx; padding: 18rpx; background: #fcfdf7; border: 1rpx solid #e0e7d3; border-radius: 19rpx; }
.calendar-nav { display: flex; justify-content: space-between; align-items: center; margin: 0 0 17rpx; font-size: 25rpx; font-weight: 600; }
.calendar-nav .month-arrow { font-size: 36rpx; width: 52rpx; height: 52rpx; flex: 0 0 52rpx; color: #6c8453; background: #eef3e4; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.calendar-nav button[disabled] { background: #f7f8f1; color: #c8cfbc; }
.weekdays { display: flex; font-size: 20rpx; color: #a3ad93; margin-bottom: 9rpx; }
.weekdays text { width: 14.285714%; text-align: center; }
.calendar-grid { display: block; width: 100%; }
.calendar-row { display: flex; flex-wrap: nowrap; width: 100%; }
.calendar-day { width: 14.285714%; flex: 0 0 14.285714%; min-width: 0; padding: 4rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; position: relative; font-size: 24rpx; }
.calendar-day>text { height: 54rpx; width: 54rpx; flex: none; display: flex; justify-content: center; align-items: center; border-radius: 12rpx; }
.calendar-day.selected>text { background: #284b38; color: #fffdf3; }
.calendar-day.disabled, .calendar-day.other { color: #ccd2bf; }
.calendar-day-hover>text { background: #e9efde; }
.today-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #d3ac49; }
.calendar-day .today-dot { position: absolute; bottom: 7rpx; left: calc(50% - 3.5rpx); }
.calendar-legend { display: flex; align-items: center; font-size: 19rpx; color: #a1ac90; margin: 14rpx 5rpx 0; }
.calendar-legend .today-dot { margin-right: 10rpx; }
.calendar-selection-count { margin-left: auto; }
.calendar-actions { display: flex; align-items: center; margin-top: 17rpx; padding-top: 17rpx; border-top: 1rpx solid #e6eadb; }
.clear-dates { width: 165rpx; flex: 0 0 165rpx; font-size: 22rpx; color: #95a085; }
.done-button { flex: 1; min-width: 0; background: #284b38; color: #fffdf2; border-radius: 13rpx; padding: 16rpx 0; font-size: 24rpx; }
.help-scroll { height: 55vh; margin-top: 32rpx; }
.help-step { display: flex; margin-bottom: 33rpx; }
.help-number { color: #a2b38a; font-size: 22rpx; margin-right: 22rpx; margin-top: 3rpx; }
.help-step>view { flex: 1; min-width: 0; }
.help-title { display: block; font-size: 28rpx; font-weight: 600; margin-bottom: 11rpx; }
.help-body { display: block; font-size: 24rpx; color: #97a285; line-height: 1.85; }
.local-note { background: #f1f5e9; border-radius: 16rpx; padding: 21rpx; font-size: 22rpx; line-height: 1.85; color: #90a079; margin-bottom: 15rpx; }
.help-done { width: 100%; border-radius: 17rpx; padding: 23rpx 0; color: #fffdf3; background: #284b38; font-size: 28rpx; margin-top: 21rpx; }
@keyframes result-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 350px) { .brand-caption { display: none; } .hero-avatar { width: 135rpx; height: 135rpx; opacity: .55; right: 0; } .hero-title { font-size: 55rpx; } .spin-button { width: 310rpx; } .bottom-copy { font-size: 23rpx; } .stage-title { font-size: 26rpx; } }
