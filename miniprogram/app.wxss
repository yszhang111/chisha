page { background: #f7f7ef; color: #283e2e; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, scroll-view, button, input, image, text { box-sizing: border-box; }
/* All controls use the app's own theme instead of WeUI v2 fixed button widths. */
button { width: auto; min-width: 0; max-width: 100%; margin: 0; padding: 0; line-height: 1.5; font-size: inherit; background: transparent; color: inherit; border-radius: 0; }
button::after { border: 0; }
button[disabled] { color: #a4ad98; background: transparent; }
button.button-hover { opacity: .72; }
